# Base style to inherit sensible defaults
BasedOnStyle: LLVM

# Core Layout
Language: Cpp
Standard: c++20
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120 # 80 is a bit tight for modern screens; 100 is a sweet spot

# Parameter & Bracket Formatting
AlignAfterOpenBracket: true
BinPackParameters: BinPack         # Prevents clang-format from putting multiple parameters on a single line

# Alignment & Spacing
PointerAlignment: Left
AccessModifierOffset: -4 # Standard practice: aligns 'public:' with 'class'
AlignConsecutiveAssignments: true
AlignTrailingComments: true

# Braces & Flow
BreakBeforeBraces: Attach
AllowShortIfStatementsOnASingleLine: Always
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: All

# Cleanliness
MaxEmptyLinesToKeep: 1
FixNamespaceComments: true # Automatically adds // namespace Name
